# Cabeceras de caché. Las lee Cloudflare en el Worker que sirve el sitio;
# servidas desde cualquier otro sitio, este fichero es texto y no hace nada.
#
# Ninguna ruta se solapa con otra. Cloudflare **fusiona** las cabeceras cuando
# varias reglas coinciden con la misma URL, y el resultado es un Cache-Control
# con dos max-age pegados que el navegador no sabe interpretar. Por eso las
# fotos se listan por extensión en vez de con un /assets/* que se tragaría
# también las fuentes.

# El HTML revalida en cada carga: los cambios de precio de Mafer salen al instante.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# El service worker nunca se cachea, si no las actualizaciones se quedan trabadas.
/sw.js
  Cache-Control: no-cache

# Las fuentes no cambian jamás.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Las fotos cambian muy de vez en cuando. Sin hash en el nombre no se puede
# usar immutable: si Mafer cambia una foto, 30 días es lo máximo que espera.
/assets/*.webp
  Cache-Control: public, max-age=2592000

/assets/*.png
  Cache-Control: public, max-age=2592000

/assets/*.svg
  Cache-Control: public, max-age=2592000

# Los iconos viven en la raíz y no encajan en ninguna regla de arriba: la regla `/`
# solo cubre la raíz exacta, no las rutas hijas. Literales, sin comodines, para que
# no puedan solaparse con nada.
/favicon.ico
  Cache-Control: public, max-age=2592000

/favicon.svg
  Cache-Control: public, max-age=2592000

/apple-touch-icon.png
  Cache-Control: public, max-age=2592000
